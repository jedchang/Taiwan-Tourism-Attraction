.footer-area {
  position: relative;
  z-index: 2;
  padding: 35px 0 30px 0;
  background-repeat: no-repeat;
  background-size: cover;
  background-color: $textDarkColor;
  @include extraSmall {
    padding: 27px 0 20px 0;
    bottom: 0px;
  }

  .copyright-text {
    text-align: center;
    font-size: 14px;
    letter-spacing: 0.28px;
    color: #4f6891;
    line-height: 1.3;
    display: flex;
    justify-content: center;
    align-items: center;
    @include extraSmall {
      display: inline-block;
      letter-spacing: 0;
      color: #707070;
    }
  }
  .material-icons {
    font-size: 16px;
    margin: 0 5px;
    @include extraSmall {
      font-size: 14px;
      margin: 0 0;
      vertical-align: middle;
    }
  }
  a {
    font-size: 14px;
    letter-spacing: 0.42px;
    color: #4f6891;
    font-weight: 500;
    display: inline-block;
    margin-left: 5px;
    transition: $setTransition;
    @include extraSmall {
      color: #707070;
    }
    &:hover {
      color: $primaryColor;
    }
  }
}
