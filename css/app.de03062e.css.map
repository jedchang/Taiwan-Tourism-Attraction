.tab-content {
  .item {
    background-color: #ffffff;
    -webkit-box-shadow: 0px 3px 9px #071c551f;
    box-shadow: 0px 3px 9px #071c551f;
    position: relative;
    margin-bottom: 35px;
    padding: 8px;
    border-radius: 6px;
    height: 423px;
    @include small {
      height: auto;
    }
    @include extraSmall {
      height: auto;
      width: 100%;
      margin: 0 0 30px 0;
    }

    &:before {
      content: '';
      position: absolute;
      height: 10px;
      width: 100%;
      background: rgba(243, 148, 30, 0.3);
      bottom: 0;
      left: 0;
      border-bottom-left-radius: 6px;
      border-bottom-right-radius: 6px;
    }
    &:after {
      content: '';
      position: absolute;
      left: auto;
      right: 0;
      bottom: 0;
      width: 0%;
      height: 10px;
      border-bottom-left-radius: 6px;
      border-bottom-right-radius: 6px;
      background-color: $primaryColor;
      transition: $setTransition;
      visibility: hidden;
      opacity: 0;
    }
    &:hover {
      &:after {
        visibility: visible;
        opacity: 1;
        right: auto;
        left: 0;
        width: 100%;
        bottom: 0;
      }
      .thumb img {
        transform: scale(1.1);
      }
      .thumb:after {
        visibility: visible;
        opacity: 0.2;
      }
      .thumb .detail-btn {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(-40%);
      }
    }
  }

  .thumb {
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    height: 203px;
    background-color: #e7e7e7;
    @include small {
      height: 250px;
    }
    @include extraSmall {
      height: 250px;
    }
    &:after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 0;
      bottom: 0;
      width: 100%;
      height: 100%;
      background-color: #000000;
      transition: $setTransition;
      z-index: 0;
      visibility: hidden;
      opacity: 0;
    }
    img {
      display: block;
      width: 100%;
      // max-width: 100%;
      height: auto;
      // height: 100%; // 設 auto 無法置中
      min-height: 203px; // 有些圖片超高
      object-fit: cover;
      object-position: center;
      transition: $setTransition;
      @include small {
        width: 100%;
        height: 100%;
        min-height: 250px;
      }
      @include extraSmall {
        width: 100%;
        height: 100%;
        min-height: 250px;
      }
    }
    .detail-btn {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translateX(-50%) translateY(0);
      opacity: 0;
      visibility: hidden;
      width: 50%;
      padding: 8px 16px;
      background-color: $secondaryColor;
      color: #fff;
      border-radius: 20px;
      z-index: 2;
      border: none;
      display: flex;
      justify-content: center;
      align-items: center;
      transition: $setTransition;
      @include extraLarge {
        width: 60%;
      }
      @include large {
        width: 55%;
      }
      @include medium {
        width: 50%;
      }
      @include small {
        width: 50%;
        padding: 16px 16px;
        border-radius: 25px;
      }
      @include extraSmall {
        width: 55%;
        padding: 16px 16px;
        border-radius: 25px;
      }
      &:hover {
        background-color: darken($secondaryColor, 10%);
        cursor: pointer;
      }
      span {
        margin-left: 5px;
      }
      .material-icons {
        font-size: 22px;
      }
    }
  }

  .picture {
    position: relative;
    a {
      display: block;
      overflow: hidden;

      img {
        width: 100%;
        height: 240px;
        object-fit: cover;
      }
    }
    .type {
      top: -13px;
      left: 0;
      font-size: 1.25rem;
      background-color: $primaryColor;
      padding: 12px 20px;
      position: absolute;
      border-radius: 0 5px 5px 0px;
      color: #fff;
      text-align: center;
    }
  }

  .content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 30px 12px 20px;
    position: relative;

    .category {
      width: auto;
      height: 32px;
      background-color: #ffffff;
      border-top-right-radius: 6px;
      display: flex;
      justify-content: center;
      align-items: center;
      position: absolute;
      top: -16px;
      left: 0px;
      padding: 6px 12px;
      @include small {
        left: 50%;
        transform: translateX(-50%);
        border-top-left-radius: 6px;
      }
      @include extraSmall {
        left: 50%;
        transform: translateX(-50%);
        border-top-left-radius: 6px;
      }
      .material-icons {
        font-size: 20px;
        color: $secondaryColor;
      }
      p {
        font-size: 12px;
        text-transform: uppercase;
        color: $secondaryColor;
        margin-left: 5px;
      }
    }

    .name {
      font-size: 22px;
      font-weight: 600;
      height: 55px; // 兩行標題高度
      color: $textDarkColor;
      margin-bottom: 20px;
      padding-bottom: 5px;
      text-align: left;
      @include small {
        height: auto;
        text-align: center;
      }
      @include extraSmall {
        height: auto;
        text-align: center;
      }
    }

    .tags-all {
      margin-bottom: 3px;
      display: flex;
      justify-content: flex-start;
      align-items: center;
      flex-wrap: wrap;
      @include small {
        justify-content: center;
      }
      @include extraSmall {
        justify-content: center;
      }
      li {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        color: $textColor;
        list-style: none;
        text-align: left;
        font-size: 14px;
        word-break: break-all;
        margin-right: 10px;
        margin-bottom: 8px;
        &:last-child {
          margin-right: 0;
        }
        .tag {
          padding: 6px 8px;
          border: 1px solid $primaryColor;
          color: $primaryColor;
          border-radius: 4px;
        }
      }
    }
  }
}
